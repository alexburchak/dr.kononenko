---
import Base from '../../layouts/Base.astro';
import aftercare from '../../data/aftercare.yaml';
import { url } from '../../lib/url';
---
<Base title="Пам'ятки після процедур">
  <section class="page-hero">
    <div class="container">
      <h1>Пам'ятки після процедур</h1>
      <p>Як доглядати за шкірою після процедури, щоб отримати найкращий результат.</p>
    </div>
  </section>
  <section class="section" style="padding-top: 24px">
    <div class="container grid grid--3">
      {aftercare.map((a: { slug: string; title: string }) => (
        <a class="card" href={url(`pamiatky/${a.slug}/`)}><h3>{a.title}</h3><span class="card__more">Відкрити →</span></a>
      ))}
    </div>
  </section>
</Base>
