---
import Base from '../../layouts/Base.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import site from '../../data/site.yaml';
import aftercare from '../../data/aftercare.yaml';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return aftercare.map((a: { slug: string }) => ({ params: { slug: a.slug }, props: { memo: a } }));
}

const { memo } = Astro.props;
---
<Base title={`Пам'ятка: ${memo.title.toLowerCase()}`}>
  <section class="section memo">
    <div class="container narrow">
      <Eyebrow><a href={url('pamiatky/')}>Пам'ятки</a></Eyebrow>
      <h1>{memo.title}</h1>
      <div class="memo__card">
        <ul class="list-check">
          {memo.rules.map((r: string) => <li><svg aria-hidden="true"><use href="#i-check" /></svg>{r}</li>)}
        </ul>
      </div>
      <p class="notice">{memo.warning} <a href={`https://t.me/${site.contacts.telegram}`}>Telegram</a> · <a href={`tel:${site.contacts.phone}`}>{site.contacts.phoneDisplay}</a>{site.contacts.phone2 && <> · <a href={`tel:${site.contacts.phone2}`}>{site.contacts.phone2Display}</a></>}</p>
    </div>
  </section>
</Base>

<style>
  .memo { padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(110px, 12vw, 160px); }
  .memo__card { margin-top: 28px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(24px, 4vw, 44px); box-shadow: var(--sh-1); }
  .memo__card .list-check { margin: 0; }
  .notice a { font-style: normal; font-weight: 700; }
</style>
