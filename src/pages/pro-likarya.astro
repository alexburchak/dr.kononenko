---
import Base from '../layouts/Base.astro';
import BookingCta from '../components/BookingCta.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Sprig from '../components/Sprig.astro';
import Wave from '../components/Wave.astro';
import site from '../data/site.yaml';
import { url } from '../lib/url';

const points = [
  'Лікар-дерматолог з вищою медичною освітою',
  site.about.experienceYears ? `${site.about.experienceYears}+ років практики` : null,
  'Доказовий підхід: спочатку діагноз, потім процедура',
  'Лише сертифіковані препарати та стерильні інструменти',
].filter(Boolean);
---
<Base title="Про лікаря" description={`${site.doctorName} — лікар-дерматолог, косметолог у Дніпрі. Освіта, досвід, сертифікати.`}>
  <section class="section intro">
    <div class="container split">
      <div>
        <Eyebrow class="reveal">Про лікаря</Eyebrow>
        <h1 class="reveal d1">{site.doctorName}</h1>
        <blockquote class="philo reveal d2">{site.about.intro}</blockquote>
        <ul class="list-check reveal d3">
          {points.map((p) => <li><svg aria-hidden="true"><use href="#i-check" /></svg>{p}</li>)}
        </ul>
      </div>
      <div class="split__art reveal d1">
        <Sprig />
        <div class="arch portrait"><img src={url(site.images.portrait)} alt={site.doctorName} width="900" height="1100" /></div>
        <div class="sig"><b>{site.doctorName}</b><span>дерматолог · косметолог</span></div>
      </div>
    </div>
  </section>

  <Wave fill="oat" />
  <section class="section bg-oat">
    <div class="container edu">
      <div>
        <Eyebrow class="reveal">Освіта</Eyebrow>
        <h2 class="reveal d1">Освіта та <em>досвід</em></h2>
      </div>
      <ul class="timeline reveal d2">
        {site.about.education.map((e: { year: string; text: string }) => <li><b>{e.year}</b><span>{e.text}</span></li>)}
      </ul>
    </div>
  </section>
  <Wave fill="oat" flip variant={2} />

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <Eyebrow class="reveal">Документи</Eyebrow>
        <h2 class="reveal d1">Дипломи та <em>сертифікати</em></h2>
      </div>
      <div class="grid grid--3">
        {site.certificates.map((c: { image: string; caption: string }, i: number) => (
          <figure class:list={['cert', 'reveal', `d${i % 3}`]}>
            <img src={url(c.image)} alt={c.caption} width="900" height="650" loading="lazy" />
            <figcaption>{c.caption}</figcaption>
          </figure>
        ))}
      </div>
      <p class="license reveal">{site.license}</p>
    </div>
  </section>

  <BookingCta />
</Base>

<style>
  .intro { padding-top: clamp(48px, 7vw, 88px); }
  .portrait { aspect-ratio: 4 / 5; }
  .philo { margin: 10px 0 30px; padding: 26px 30px; background: var(--paper); border-radius: var(--r); border-left: 3px solid var(--honey); font-family: var(--f-serif); font-style: italic; font-size: clamp(18px, 1.7vw, 21px); line-height: 1.6; color: var(--sage-800); }
  .sig { position: absolute; right: -18px; bottom: 28px; background: var(--paper); padding: 16px 20px; border-radius: var(--r); box-shadow: var(--sh-2); border: 1px solid var(--line); }
  .sig b { display: block; font-family: var(--f-display); font-weight: 400; font-size: 19px; color: var(--forest); }
  .sig span { font-size: 13px; color: var(--muted); }
  .edu { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .cert { margin: 0; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 14px; transition: transform .45s var(--ease), box-shadow .45s; }
  .cert:hover { transform: translateY(-6px); box-shadow: var(--sh-2); }
  .cert img { border-radius: var(--r); width: 100%; aspect-ratio: 9 / 6.5; object-fit: cover; }
  .cert figcaption { margin: 14px 6px 4px; font-family: var(--f-serif); font-style: italic; color: var(--sage-800); }
  .license { margin-top: 40px; text-align: center; color: var(--muted); font-size: 14px; }
  @media (max-width: 860px) { .edu { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .sig { right: 8px; } }
</style>
