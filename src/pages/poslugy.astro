---
import Base from '../layouts/Base.astro';
import PriceGroup from '../components/PriceGroup.astro';
import BookingCta from '../components/BookingCta.astro';
import prices from '../data/prices.yaml';
---
<Base title="Послуги та ціни" description="Послуги та ціни лікаря-дерматолога, косметолога в Дніпрі: консультація, чистки, пілінги, ін'єкційні методики, лікування акне.">
  <section class="page-hero">
    <div class="container">
      <h1>Послуги та ціни</h1>
      <p>Остаточна вартість залежить від стану шкіри та обсягу процедури і узгоджується на консультації.</p>
      <nav class="chips">
        {prices.map((g: { group: string; id: string }) => <a href={`#${g.id}`}>{g.group}</a>)}
      </nav>
    </div>
  </section>
  <section class="section" style="padding-top: 24px">
    <div class="container">
      {prices.map((g: any) => <PriceGroup group={g} />)}
      <p class="notice">Є протипоказання. Ін'єкційні методики, пілінги та лікування акне — лише після консультації лікаря.</p>
    </div>
  </section>
  <BookingCta />
</Base>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 1rem; }
  .chips a { padding: .4em 1em; border-radius: 999px; background: var(--c-soft); text-decoration: none; font-size: .92rem; }
</style>
