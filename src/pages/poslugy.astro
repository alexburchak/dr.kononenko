---
import Base from '../layouts/Base.astro';
import PriceGroup from '../components/PriceGroup.astro';
import BookingCta from '../components/BookingCta.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Wave from '../components/Wave.astro';
import prices from '../data/prices.yaml';
---
<Base title="Послуги та ціни" description="Послуги та ціни лікаря-дерматолога, косметолога в Дніпрі: консультація, чистки, пілінги, ін'єкційні методики, лікування акне.">
  <section class="page-hero">
    <div class="container">
      <Eyebrow class="reveal">Ціни</Eyebrow>
      <h1 class="reveal d1">Послуги та <em>ціни</em></h1>
      <p class="lead reveal d2">Остаточна вартість залежить від стану шкіри та обсягу процедури і узгоджується на консультації.</p>
      <nav class="chips reveal d3" aria-label="Групи послуг">
        {prices.map((g: { group: string; id: string }) => <a class="chip" href={`#${g.id}`}><svg aria-hidden="true"><use href="#i-sprig" /></svg>{g.group}</a>)}
      </nav>
    </div>
  </section>

  <Wave fill="oat" />
  <section class="section bg-oat">
    <div class="container narrow">
      {prices.map((g: any) => <PriceGroup group={g} />)}
      <p class="notice reveal">Є протипоказання. Ін'єкційні методики, пілінги та лікування акне — лише після консультації лікаря.</p>
    </div>
  </section>
  <Wave fill="oat" flip variant={3} />

  <BookingCta />
</Base>

<style>
  .chips { margin-top: 28px; }
  .narrow { max-width: 900px; }
</style>
