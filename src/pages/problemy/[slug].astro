---
import Base from '../../layouts/Base.astro';
import BookingCta from '../../components/BookingCta.astro';
import PriceGroup from '../../components/PriceGroup.astro';
import problems from '../../data/problems.yaml';
import prices from '../../data/prices.yaml';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return problems.map((p: { slug: string }) => ({ params: { slug: p.slug }, props: { problem: p } }));
}

const { problem } = Astro.props;
const group = prices.find((g: { id: string }) => g.id === problem.priceGroup);
---
<Base title={problem.seoTitle} description={`${problem.title}: ${problem.summary} Причини та лікування у лікаря-дерматолога в Дніпрі.`}>
  <section class="section">
    <div class="container split">
      <div>
        <div class="eyebrow"><a href={url('problemy/')}>Проблеми шкіри</a></div>
        <h1>{problem.title}</h1>
        <p class="lead">{problem.summary}</p>
        <h2>Причини</h2>
        <p>{problem.causes}</p>
        <h2>Як лікуємо</h2>
        <p>{problem.treatment}</p>
        <p class="notice">Самолікування може погіршити стан шкіри. Лікування призначає лікар після огляду.</p>
      </div>
      <img class="photo" src={url(problem.image)} alt={problem.title} width="1200" height="800" />
    </div>
  </section>
  {group && (
    <section class="section section--soft">
      <div class="container"><PriceGroup group={group} /></div>
    </section>
  )}
  <BookingCta />
</Base>

<style>
  .lead { font-size: 1.15rem; color: var(--c-muted); }
  h2 { font-size: 1.8rem; margin-top: 1.5rem; }
</style>
