---
import Base from '../layouts/Base.astro';
import BookingCta from '../components/BookingCta.astro';
import faq from '../data/faq.yaml';
---
<Base title="Часті запитання" description="Відповіді лікаря-дерматолога на часті запитання: біль, кількість процедур, протипоказання, підготовка.">
  <section class="page-hero">
    <div class="container">
      <h1>Часті запитання</h1>
      <p>Не знайшли відповіді — напишіть, і лікар відповість особисто.</p>
    </div>
  </section>
  <section class="section" style="padding-top: 24px">
    <div class="container faq">
      {faq.map((f: { question: string; answer: string }) => (
        <details class="card">
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </section>
  <BookingCta />
</Base>

<style>
  .faq { display: grid; gap: 12px; max-width: 820px; }
  .faq details { padding: 20px 24px; }
  .faq summary { cursor: pointer; font-weight: 600; font-size: 1.08rem; }
  .faq details[open] summary { margin-bottom: .6rem; }
</style>
