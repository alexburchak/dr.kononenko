---
import Base from '../layouts/Base.astro';
import BookingCta from '../components/BookingCta.astro';
import Eyebrow from '../components/Eyebrow.astro';
import site from '../data/site.yaml';
import faq from '../data/faq.yaml';
---
<Base title="Часті запитання" description="Відповіді лікаря-дерматолога на часті запитання: біль, кількість процедур, протипоказання, підготовка.">
  <section class="section faq-sec">
    <div class="container faq-grid">
      <div class="faq-aside">
        <Eyebrow class="reveal">Питання</Eyebrow>
        <h1 class="reveal d1">Часті <em>запитання</em></h1>
        <p class="lead reveal d2">Не знайшли відповіді — напишіть, і лікар відповість особисто.</p>
        <p class="reveal d3"><a class="btn btn--primary" href={`https://t.me/${site.contacts.telegram}`} target="_blank" rel="noopener">Написати в Telegram <svg aria-hidden="true"><use href="#i-arrow" /></svg></a></p>
      </div>
      <div class="faq-list">
        {faq.map((f: { question: string; answer: string }, i: number) => (
          <details class:list={['faq-item', 'reveal', `d${Math.min(i, 3)}`]}>
            <summary>{f.question}<span class="pm" aria-hidden="true"></span></summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <BookingCta />
</Base>

<style>
  .faq-sec { padding-top: clamp(48px, 7vw, 88px); }
  .faq-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(40px, 6vw, 80px); align-items: start; }
  .faq-aside { position: sticky; top: 110px; }
  .faq-list { display: grid; gap: 14px; }
  .faq-item { background: var(--paper); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; transition: box-shadow .35s; }
  .faq-item[open] { box-shadow: var(--sh-1); }
  summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 26px; cursor: pointer; font-family: var(--f-display); font-size: clamp(18px, 1.7vw, 21px); color: var(--forest); line-height: 1.35; }
  summary::-webkit-details-marker { display: none; }
  .pm { width: 34px; height: 34px; flex: none; border-radius: 50%; background: var(--sage-50); position: relative; transition: background .3s, transform .4s var(--ease); }
  .pm::before, .pm::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 1.5px; background: var(--forest); transform: translate(-50%, -50%); }
  .pm::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform .4s var(--ease); }
  .faq-item[open] .pm { background: var(--honey-soft); transform: rotate(180deg); }
  .faq-item[open] .pm::after { transform: translate(-50%, -50%) rotate(0); }
  .faq-item p { padding: 0 26px 24px; margin: 0; color: var(--muted); font-size: 16px; }
  @media (max-width: 960px) {
    .faq-grid { grid-template-columns: 1fr; }
    .faq-aside { position: static; }
  }
</style>
