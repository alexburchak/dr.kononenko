---
import Base from '../layouts/Base.astro';
import BookingButtons from '../components/BookingButtons.astro';
import Eyebrow from '../components/Eyebrow.astro';
import site from '../data/site.yaml';

const c = site.contacts;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.address.mapQuery)}&output=embed`;
---
<Base title="Контакти та запис" description={`Запис до лікаря-дерматолога в Дніпрі: ${site.address.street}. Telegram, Viber, телефон.`}>
  <section class="section contact">
    <div class="container">
      <div class="section-head center">
        <Eyebrow class="reveal">Запис і візит</Eyebrow>
        <h1 id="zapys" class="reveal d1">Контакти та <em>запис</em></h1>
        <p class="lead reveal d2">{site.hoursNote} Напишіть у зручний месенджер — підберемо час.</p>
      </div>
      <div class="contact-grid">
        <div class="book-card reveal">
          <h2>Записатися на прийом</h2>
          <p class="book-card__note">Оберіть зручний спосіб зв'язку:</p>
          <BookingButtons split />
          <ul class="info-list">
            <li><svg aria-hidden="true"><use href="#i-pin" /></svg><div><b>Адреса</b>{site.address.city}, {site.address.street}<br />{site.address.landmark}</div></li>
            <li><svg aria-hidden="true"><use href="#i-phone" /></svg><div><b>Телефони</b><a href={`tel:${c.phone}`}>{c.phoneDisplay}</a> · Viber{c.phone2 && <><br /><a href={`tel:${c.phone2}`}>{c.phone2Display}</a> · Telegram</>}</div></li>
            <li><svg aria-hidden="true"><use href="#i-chat" /></svg><div><b>Месенджери</b><a href={`https://t.me/${c.telegram}`} target="_blank" rel="noopener">Telegram</a> · <a href={`https://www.instagram.com/${c.instagram}`} target="_blank" rel="noopener">Instagram</a></div></li>
          </ul>
        </div>
        <aside class="info-card reveal d1">
          <iframe class="map" src={mapSrc} title="Мапа: як дістатися" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <div>
            <h2 class="info-card__h">Графік роботи</h2>
            <table class="hours">
              {site.hours.map((h: { days: string; time: string }) => <tr><td>{h.days}</td><td>{h.time}</td></tr>)}
            </table>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact { padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(110px, 12vw, 160px); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: stretch; }
  .book-card { background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(26px, 4vw, 48px); box-shadow: var(--sh-2); }
  .book-card h2 { font-size: clamp(26px, 2.6vw, 34px); margin-bottom: 8px; }
  .book-card__note { color: var(--muted); margin-bottom: 22px; }
  .info-list { list-style: none; padding: 30px 0 0; margin: 32px 0 0; border-top: 1px solid var(--line); display: grid; gap: 20px; }
  .info-list li { display: flex; gap: 14px; align-items: flex-start; }
  .info-list svg { width: 22px; height: 22px; flex: none; color: var(--honey-600); margin-top: 3px; }
  .info-list b { display: block; color: var(--olive); font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 2px; }
  .info-card { background: var(--forest); color: #dde3d5; border-radius: var(--r-lg); padding: clamp(20px, 3vw, 32px); display: flex; flex-direction: column; gap: 26px; }
  .map { width: 100%; flex: 1; min-height: 340px; border: 0; border-radius: var(--r); background: var(--oat); }
  .info-card__h { font-family: var(--f-sans); font-size: 12.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--honey); font-weight: 700; margin-bottom: 10px; }
  .hours { width: 100%; border-collapse: collapse; font-size: 15px; }
  .hours td { padding: 8px 0; border-bottom: 1px solid rgba(221, 227, 213, .14); }
  .hours td:last-child { text-align: right; color: var(--cream); }
  .hours tr:last-child td { border-bottom: 0; }
  @media (max-width: 960px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
