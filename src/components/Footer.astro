---
import site from '../data/site.yaml';
import { url } from '../lib/url';
import Wave from './Wave.astro';

const c = site.contacts;
const startYear = 2026;
const year = new Date().getFullYear();
const years = year > startYear ? `${startYear}–${year}` : `${startYear}`;
---
<footer class="site-footer">
  <Wave fill="forest" variant={2} />
  <div class="container">
    <div class="foot-grid">
      <div>
        <a class="logo" href={url('/')}>
          <img class="logo__mark" src={url('images/logo.svg')} alt="" width="42" height="42" />
          <span class="logo__text"><b>{site.brand}</b><small>дерматолог · косметолог</small></span>
        </a>
        <p class="foot-about">{site.title}</p>
      </div>
      <div>
        <h4>Сайт</h4>
        <ul>
          <li><a href={url('poslugy/')}>Послуги та ціни</a></li>
          <li><a href={url('pro-likarya/')}>Про лікаря</a></li>
          <li><a href={url('problemy/')}>Проблеми шкіри</a></li>
          <li><a href={url('pamiatky/')}>Пам'ятки після процедур</a></li>
        </ul>
      </div>
      <div>
        <h4>Контакти</h4>
        <ul>
          <li><a href={`tel:${c.phone}`}>{c.phoneDisplay}</a> <small>Viber</small></li>
          {c.phone2 && <li><a href={`tel:${c.phone2}`}>{c.phone2Display}</a> <small>Telegram</small></li>}
          <li><a href={`https://t.me/${c.telegram}`} target="_blank" rel="noopener">Telegram</a> · <a href={`https://www.instagram.com/${c.instagram}`} target="_blank" rel="noopener">Instagram</a></li>
          <li>{site.address.city}, {site.address.street}</li>
        </ul>
      </div>
      <div>
        <h4>Графік</h4>
        <ul>
          {site.hours.map((h: { days: string; time: string }) => <li>{h.days}: {h.time}</li>)}
          <li>{site.hoursNote}</li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>{site.license}</span>
      <span>
        Є протипоказання, необхідна консультація лікаря. ·
        <a href={url('konfidentsiinist/')}>Конфіденційність</a> ·
        © <span id="copy-years" data-start={startYear}>{years}</span> {site.brand}
      </span>
    </div>
  </div>
</footer>
<script is:inline>
  // Рік береться з браузера відвідувача, тож діапазон оновлюється без перезбирання сайту.
  (function () {
    var el = document.getElementById('copy-years');
    if (!el) return;
    var start = +el.dataset.start, now = new Date().getFullYear();
    el.textContent = now > start ? start + '–' + now : String(start);
  })();
</script>

<style>
  .site-footer { position: relative; background: var(--forest); color: #b9c3b1; padding: 10px 0 40px; font-size: 14.5px; }
  .site-footer > :global(.wave) { position: absolute; left: 0; bottom: 100%; margin: 0 0 -1px; }
  .site-footer a { color: inherit; text-decoration: none; }
  .site-footer a:hover { color: var(--cream); }
  .foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; padding: 40px 0; border-bottom: 1px solid rgba(221, 227, 213, .14); }
  .logo { display: flex; align-items: center; gap: 12px; }
  .logo__mark { width: 42px; height: 42px; flex: none; background: var(--cream); border-radius: 50%; }
  .logo__text { display: flex; flex-direction: column; line-height: 1; }
  .logo__text b { font-family: var(--f-display); font-weight: 400; font-size: 22px; color: var(--cream); }
  .logo__text small { font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: var(--honey); margin-top: 6px; font-weight: 700; }
  li small { opacity: .7; }
  .foot-about { margin-top: 18px; max-width: 34ch; }
  h4 { font-family: var(--f-sans); font-size: 12.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--honey); font-weight: 700; margin-bottom: 16px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 9px; }
  .foot-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-top: 26px; font-size: 13px; }
  @media (max-width: 1080px) { .foot-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .foot-grid { grid-template-columns: 1fr; } }
</style>
