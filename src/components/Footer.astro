---
import site from '../data/site.yaml';
import { url } from '../lib/url';

const c = site.contacts;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__grid">
    <div>
      <div class="footer__brand">{site.brand}</div>
      <p>{site.title}</p>
      <p class="footer__muted">{site.address.city}, {site.address.street}</p>
    </div>
    <div>
      <div class="footer__h">Контакти</div>
      <p>
        <a href={`tel:${c.phone}`}>{c.phoneDisplay}</a><br />
        <a href={`https://t.me/${c.telegram}`} target="_blank" rel="noopener">Telegram</a> ·
        <a href={`https://instagram.com/${c.instagram}`} target="_blank" rel="noopener">Instagram</a>
      </p>
    </div>
    <div>
      <div class="footer__h">Графік</div>
      <p>{site.hours.map((h: { days: string; time: string }) => <>{h.days}: {h.time}<br /></>)}</p>
    </div>
  </div>
  <div class="container footer__bottom">
    <p>{site.license}</p>
    <p>
      Є протипоказання, необхідна консультація лікаря. ·
      <a href={url('konfidentsiinist/')}>Конфіденційність</a> ·
      © {year} {site.brand}
    </p>
  </div>
</footer>

<style>
  .footer { background: var(--c-primary-dark); color: #dbe6e3; padding: 56px 0 24px; margin-top: 0; font-size: .95rem; }
  .footer a { color: #fff; }
  .footer__grid { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .footer__brand { font-family: var(--font-serif); font-size: 1.7rem; color: #fff; margin-bottom: .4rem; }
  .footer__h { font-weight: 700; color: #fff; margin-bottom: .5rem; }
  .footer__muted { opacity: .8; }
  .footer__bottom { border-top: 1px solid rgba(255, 255, 255, .15); margin-top: 32px; padding-top: 20px; font-size: .82rem; opacity: .85; }
  .footer__bottom p { margin-bottom: .4em; }
</style>
